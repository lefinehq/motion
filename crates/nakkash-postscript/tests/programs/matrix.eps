%!PS-3.0 EPSF-3.0
%%BoundingBox: 0 0 100 100
%%EndComments
% A unit square placed by translate and scale, one turned by rotate, and a
% line stroked in a squashed space, so its pen is squashed too.
/unit { newpath 0 0 moveto 1 0 lineto 1 1 lineto 0 1 lineto closepath fill } def
gsave 10 10 translate 20 20 scale 1 0 0 setrgbcolor unit grestore
gsave 75 10 translate 45 rotate 15 15 scale 0 1 0 setrgbcolor unit grestore
gsave 50 70 translate 1 0.25 scale 0 0 1 setrgbcolor 20 setlinewidth
  newpath -40 0 moveto 40 0 lineto stroke grestore
showpage
